# === BSC Scanner Dashboard — omgevingsvariabelen ===
# Kopieer naar .env en vul in. (.env staat in .gitignore)

PORT=3099
BSCSCAN_API_KEY=            # Etherscan V2 API key (vereist voor contract-source/ABI ophalen)
CLAUDE_API_KEY=            # of CLAUDE_KEY — Anthropic API key voor AI-exploit/Pashov
BSC_RPC=https://bsc-dataseed1.binance.org

# Auth (ZET DEZE — de code heeft geen onveilige defaults meer nodig)
SCANNER_API_KEY=           # gedeelde sleutel met de scanner
DASH_KEY=                  # wachtwoord voor het dashboard

# --- AI-modellen (env-overschrijfbaar) ---
AI_MODEL_SONNET=claude-sonnet-4-6
AI_MODEL_OPUS=claude-opus-4-6

# --- Foundry tools (alleen nodig als ze NIET op PATH staan) ---
ANVIL_PATH=
FORGE_PATH=
CAST_PATH=

# Pad naar de attack-vectors referentie (default: ./references/attack-vectors.md)
ATTACK_VECTORS_FILE=
